# ==============================================================================
# NEXI Focus Companion - Environment Variables
# ==============================================================================
# Copy this file to .env or configure settings within NEXI's Settings menu.
# All settings and API keys can be managed securely within the desktop UI
# and are saved to your local encrypted Windows SQLite store.

# Optional: Groq API Key for NEXI AI Habit Coach (leave blank for offline use)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=

# Optional: Custom port for Chromium Browser Extension bridge (default: 19876)
NEXI_EXTENSION_PORT=19876

# Optional: Custom database storage path override (defaults to %APPDATA%\FocusCompanion\focus_companion.db)
# FOCUS_COMPANION_DB=
